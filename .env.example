# ==============================================================================
# NihongoHub — Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (Render Environment Variables)
# ------------------------------------------------------------------------------

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@nihongohub.mongodb.net/nihongohub?retryWrites=true&w=majority

# JWT Secret for Session & Authentication Tokens (Use a strong random string)
JWT_SECRET=your_production_jwt_secret_token_key_here

# Authentication Mode: "password" (temporary password authentication) or "otp" (email OTP verification via Resend)
AUTH_MODE=password

# Server Port (Render automatically injects PORT, but defaults to 5001 locally)
PORT=5001

# Node Environment
NODE_ENV=production

# Frontend Origin URL for CORS (Your Vercel deployment URL, e.g. https://your-app.vercel.app)
# Supports comma-separated origins if using multiple domains
FRONTEND_URL=https://<your-app>.vercel.app

# Admin Promotion Secret Key (for bootstrapping the initial admin via API if needed)
ADMIN_SECRET_KEY=your_admin_promotion_secret_key_here

# Resend HTTPS API Configuration for OTP Authentication
# (Communicates over HTTPS port 443 — works smoothly on Render Free without SMTP port blocking)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=NihongoHub <onboarding@resend.dev>

# Session Inactivity Timeout in Minutes (optional, defaults to 60)
SESSION_IDLE_TIMEOUT_MINUTES=60

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vercel Environment Variables)
# ------------------------------------------------------------------------------

# Render Backend URL (Public URL of your backend on Render, e.g. https://your-backend.onrender.com)
VITE_API_URL=https://<your-backend>.onrender.com

